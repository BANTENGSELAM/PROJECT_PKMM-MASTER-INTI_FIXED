# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env.
# Dapatkan MAP_KEY gratis di: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=YOUR_MAP_KEY_HERE

# Sumber NASA FIRMS NRT yang diambil (pisahkan dengan koma). Bila kosong,
# keempat sumber didukung dan diperiksa secara independen:
# VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT
# Satu sumber gagal tidak menghapus hasil sumber lain; status parsial
# dilaporkan di /api/hotspots.
FIRMS_SOURCES=

# Pilihan rumus NDWI: green_nir (default) atau nir_swir
NDWI_FORMULA=green_nir

# --- Notification system (opsional) ---
# Ambang skor kelas 1 minimal agar XGBoost menghasilkan WASPADA (0.0 - 1.0).
WASPADA_MIN_SCORE=0.5
# Interval polling FIRMS latar belakang dalam detik (minimal 60).
NOTIFICATION_FIRMS_INTERVAL=900
# Batas retensi riwayat notifikasi dan event pada notification_state.json.
# Nilai 0 berarti tanpa batas (retensi penuh).
NOTIFICATION_MAX_RECORDS=2000
NOTIFICATION_MAX_EVENTS=1000
# Bila diisi, endpoint verifikasi DARURAT mewajibkan header X-Verify-Token.
VERIFY_TOKEN=
